<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>SpaceEngineers.Core.DependencyInjection</AssemblyName>
        <RootNamespace>SpaceEngineers.Core.DependencyInjection</RootNamespace>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" />
        <PackageReference Include="StyleCop.Analyzers" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="SimpleInjector" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Basics\Basics.csproj" />
        <ProjectReference Include="..\DependencyInjection.SourceGenerators\DependencyInjection.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
      <Compile Update="Registration\InstanceDependencyInjectionRegistrationInfo.cs">
        <DependentUpon>IDependencyInjectionDependencyRegistrationInfo.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\ServiceDependencyInjectionRegistrationInfo.cs">
        <DependentUpon>IDependencyInjectionDependencyRegistrationInfo.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\DelegateDependencyInjectionRegistrationInfo.cs">
        <DependentUpon>IDependencyInjectionDependencyRegistrationInfo.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\DependencyContainerRegistration.cs">
        <DependentUpon>IDependencyInjectionRegistration.cs</DependentUpon>
      </Compile>
      <Compile Update="DependencyContainer.cs">
        <DependentUpon>IDependencyContainer.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\DependencyInjectionRegistrationContainer.cs">
        <DependentUpon>IDependencyInjectionRegistrationContainer.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\DecoratorDependencyInjectionRegistrationInfo.cs">
        <DependentUpon>IDependencyInjectionRegistrationInfo.cs</DependentUpon>
      </Compile>
      <Compile Update="Registration\IDependencyInjectionDependencyRegistrationInfo.cs">
